# Copy to .env. Never commit real keys.
OPENWEATHER_API_KEY=
# ADK execution: local (one backend) or a2a (four remote services).
VOYAGEPLUS_TRANSPORT=local
# Provider/model recognized by LiteLLM.
VOYAGEPLUS_MODEL=gemini/gemini-3.1-flash-lite
VOYAGEPLUS_ENABLE_LLM=true
GEMINI_API_KEY=
# Alternative providers (set VOYAGEPLUS_MODEL accordingly):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
GEOAPIFY_API_KEY=

# Real flight searches (two one-way searches per trip; one adult, EUR).
SERPAPI_API_KEY=
